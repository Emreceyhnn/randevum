# Public origin of the site (canonical links, sitemap, social cards), no trailing slash
SITE_URL="http://localhost:3000"
# "landing" (default): "/" shows the Randevum product page + /canli-demo.
# "business": "/" redirects straight to your booking page (use this for a client's own install).
SITE_MODE="landing"

# Docker only: host port the app is published on (bound to 127.0.0.1)
APP_PORT=3002
# Docker only: seed the demo business the first time the database is created
SEED_DEMO=true
